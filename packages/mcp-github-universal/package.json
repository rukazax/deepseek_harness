{
  "name": "mcp-github-universal",
  "version": "0.2.0",
  "description": "Universal GitHub access for DeepSeek Harness over MCP: official local GitHub MCP Server binary (fine-grained PAT friendly) with the cloud endpoint as fallback, plus a local Git server from a DSH-home venv",
  "type": "module",
  "exports": {
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg",
    "./package.json": "./package.json"
  },
  "files": [
    "cordis.patch.yml",
    "README.md",
    "icon.svg",
    "locale/*.json"
  ],
  "keywords": [
    "dsh-plugin",
    "deepseek-harness",
    "mcp",
    "github",
    "model-context-protocol",
    "git",
    "code-review",
    "issues",
    "pull-requests"
  ],
  "author": "rukazax",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rukazax/deepseek_harness.git",
    "directory": "packages/mcp-github-universal"
  },
  "homepage": "https://github.com/rukazax/deepseek_harness/tree/main/packages/mcp-github-universal",
  "bugs": {
    "url": "https://github.com/rukazax/deepseek_harness/issues"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  }
}
