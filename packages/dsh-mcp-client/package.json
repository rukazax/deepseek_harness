{
  "name": "dsh-mcp-client",
  "version": "1.1.0",
  "description": "MCP client plugin for DeepSeek Harness: spawns MCP servers, exposes their tools as native DSH tools, and restores Kimi chats as native DSH sessions.",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md"
  ],
  "keywords": [
    "dsh-plugin",
    "deepseek-harness",
    "mcp",
    "model-context-protocol",
    "sarex",
    "yandex-mail",
    "kimi",
    "session-restore"
  ],
  "author": "rukazax",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rukazax/deepseek_harness.git",
    "directory": "packages/dsh-mcp-client"
  },
  "homepage": "https://github.com/rukazax/deepseek_harness/tree/main/packages/dsh-mcp-client",
  "bugs": {
    "url": "https://github.com/rukazax/deepseek_harness/issues"
  },
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  }
}
