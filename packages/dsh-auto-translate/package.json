{
  "name": "dsh-auto-translate",
  "version": "0.1.0",
  "displayName": "Auto-translate (third-party services)",
  "description": "Optional auto-translation of any DeepSeek Harness page or dialog through third-party services (Google, Lingva, DeepL): a floating toggle, off by default, DOM watching, original-restore and a per-service cache.",
  "type": "module",
  "main": "./lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/client.js",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "keywords": [
    "dsh-plugin",
    "deepseek-harness",
    "translate",
    "localization",
    "google-translate",
    "deepl",
    "lingva"
  ],
  "author": "rukazax",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rukazax/deepseek_harness.git",
    "directory": "packages/dsh-auto-translate"
  },
  "homepage": "https://github.com/rukazax/deepseek_harness/tree/main/packages/dsh-auto-translate",
  "bugs": {
    "url": "https://github.com/rukazax/deepseek_harness/issues"
  },
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-locale"
      ],
      "platform": "web",
      "immediately": true
    }
  }
}
