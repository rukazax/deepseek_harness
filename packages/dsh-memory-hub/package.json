{
	"name": "dsh-memory-hub",
	"version": "0.4.0",
	"description": "Shared cross-chat/cross-workspace agent memory for DeepSeek Harness: stemmed signed-hash recall with a locally mined association thesaurus, citations, FTS candidate index, MCP server, eval harness — zero tokens, zero dependencies",
	"type": "module",
	"main": "./index.js",
	"exports": {
		".": "./index.js",
		"./client": "./client.js",
		"./cordis.patch.yml": "./cordis.patch.yml",
		"./locale/*.json": "./locale/*.json",
		"./icon": "./icon.svg"
	},
	"files": [
		"index.js",
		"client.js",
		"cordis.patch.yml",
		"README.md",
		"icon.svg",
		"locale/*.json",
		"tools"
	],
	"keywords": [
		"dsh-plugin",
		"deepseek-harness",
		"memory",
		"rag",
		"vector-search",
		"Habits",
		"routines",
		"skills",
		"obsidian",
		"analytics"
	],
	"author": "rukazax",
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/rukazax/deepseek_harness.git",
		"directory": "packages/dsh-memory-hub"
	},
	"homepage": "https://github.com/rukazax/deepseek_harness/tree/main/packages/dsh-memory-hub",
	"bugs": {
		"url": "https://github.com/rukazax/deepseek_harness/issues"
	},
	"engines": {
		"node": ">=22.19",
		"dsh": ">=0.2.2-rc.1 <0.3.0-0"
	},
	"dsh": {
		"bundle": {
			"patch": "./cordis.patch.yml"
		},
		"client": {
			"platform": "web",
			"immediately": true,
			"inject": [
				"@deepseek-ai/dsh-client-ui-conversation",
				"@deepseek-ai/dsh-client-ui-sidebar-right"
			]
		}
	}
}
