{
  "name": "dsh-local-settings",
  "version": "0.1.0",
  "description": "DSH local settings layer (host side): the add-workspace directory dialog opens at the configured start directory; lives outside the npm core so core updates cannot remove it",
  "type": "module",
  "main": "./index.js",
  "exports": {
    ".": "./index.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "cordis.patch.yml",
    "README.md"
  ],
  "keywords": [
    "dsh-plugin",
    "deepseek-harness",
    "settings",
    "directory-picker"
  ],
  "author": "local",
  "license": "MIT",
  "engines": {
    "node": ">=22.19",
    "dsh": ">=0.2.2-rc.1 <0.3.0-0"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  }
}
