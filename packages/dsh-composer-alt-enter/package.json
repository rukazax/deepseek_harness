{
  "name": "dsh-composer-alt-enter",
  "version": "1.0.0",
  "description": "Alt+Enter in the DSH chat composer inserts a line break (Enter keeps submitting)",
  "type": "module",
  "main": "./index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": ["index.js", "client.js", "cordis.patch.yml", "README.md", "icon.svg", "locale/*.json"],
  "keywords": ["dsh-plugin", "deepseek-harness", "composer", "keyboard", "newline", "alt-enter"],
  "author": "rukazax",
  "license": "MIT",
  "repository": { "type": "git", "url": "git+https://github.com/rukazax/deepseek_harness.git", "directory": "packages/dsh-composer-alt-enter" },
  "homepage": "https://github.com/rukazax/deepseek_harness/tree/main/packages/dsh-composer-alt-enter",
  "bugs": { "url": "https://github.com/rukazax/deepseek_harness/issues" },
  "dsh": {
    "bundle": { "patch": "./cordis.patch.yml" },
    "client": { "platform": "web", "immediately": true, "inject": ["@deepseek-ai/dsh-client-ui-conversation"] }
  }
}
